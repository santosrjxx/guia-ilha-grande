{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guia-ilha-grande",
  "compatibility_date": "2026-08-29",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sem isso, requests sem match caem com status 404 correto (bom pra SEO) mas corpo
    // vazio — o visitante via uma tela branca em vez da página 404.astro (com links de
    // navegação). "404-page" faz o Asset Worker servir dist/404.html com status 404
    // sempre que nenhum asset bate, antes mesmo de chegar no fallback do worker/index.ts.
    "not_found_handling": "404-page",
    // Por padrão (sem isso), um request que bate com um arquivo estático existente (ex.:
    // /admin/ → dist/admin/index.html) é respondido direto pelo "Asset Worker" do
    // Cloudflare e NUNCA passa pelo nosso worker/index.ts — só os requests sem match
    // (fallback) chegam até o fetch() handler abaixo.
    //
    // PRECISA SER "true" (todas as rotas), não só ["/admin/*"]: com "not_found_handling":
    // "404-page" ativo, o Asset Worker passou a responder ELE MESMO com a página 404
    // estática sempre que nenhum arquivo bate — e isso acontece ANTES do nosso fetch(),
    // pra qualquer rota fora de run_worker_first. Isso derrubou TODAS as rotas dinâmicas
    // que não correspondem a um arquivo físico em dist/ (/api/auth, /go/stats.json, o
    // catch-all de link de afiliado em /<slug>/<provedor>/, etc. — ver worker/index.ts),
    // porque nenhuma delas tinha chance de rodar: o 404 estático já tinha respondido antes.
    // Com "true", TODO request passa pelo nosso fetch() primeiro; ele mesmo chama
    // env.ASSETS.fetch() internamente (linha ~512) quando não é nenhuma rota dinâmica
    // conhecida, preservando o comportamento normal de assets e a página 404-page real
    // pra paths que não existem de verdade.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "AFFILIATE_CLICKS",
      "id": "748ac42eb9704dc48736273254900bcc"
    },
    {
      "binding": "COMMENTS",
      "id": "9f57a8229a614489b185c13038fe5076"
    }
  ]
}
