---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  maxWidth?: string;
}

const { title, description, maxWidth = '760px' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container page" style={`--page-max-width: ${maxWidth}`}>
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page { max-width: var(--page-max-width); padding-block: 2rem 3rem; }
</style>
