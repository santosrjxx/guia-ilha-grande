---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, SILOS } from '../consts';
import type { SiloKey } from '../consts';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  silo: SiloKey;
  slug: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImageWidth: number;
  heroImageHeight: number;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  faq?: { question: string; answer: string }[];
}

const {
  title,
  seoTitle,
  description,
  silo,
  slug,
  heroImage,
  heroImageAlt,
  heroImageWidth,
  heroImageHeight,
  pubDate,
  updatedDate,
  author,
  faq,
} = Astro.props;

const siloInfo = SILOS[silo];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL(heroImage ?? '/Ilha-grande.webp', SITE.url).toString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: new URL(`/${silo}/${slug}/`, SITE.url).toString(),
};
---

<BaseLayout
  title={seoTitle || title}
  description={description}
  image={heroImage}
  type="article"
  schema={[articleSchema]}
>
  <article class="container article">
    <Breadcrumbs
      items={[
        { label: 'Início', href: '/' },
        { label: siloInfo.title, href: `/${siloInfo.slug}/` },
        { label: title, href: `/${silo}/${slug}/` },
      ]}
    />

    <header class="article-header">
      <p class="badge">{siloInfo.icon} {siloInfo.title}</p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
    </header>

    {heroImage && (
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        width={heroImageWidth}
        height={heroImageHeight}
        loading="eager"
        fetchpriority="high"
        class="hero-image"
      />
    )}

    <AuthorBox author={author} updatedDate={updatedDate ?? pubDate} />

    <div class="prose">
      <slot />
    </div>

    {faq && faq.length > 0 && <FAQ items={faq} />}

    <AdSlot label={`Publicidade em ${siloInfo.title}`} />
  </article>
</BaseLayout>

<style>
  .article { max-width: 780px; padding-block: 2rem 3rem; }
  .article-header { margin-bottom: 1.5rem; }
  .article-lead { color: var(--color-text-muted); font-size: 1.1rem; }
  .hero-image { border-radius: var(--radius); margin-bottom: 1.5rem; }
  .prose :global(h2) { margin-top: 2.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    margin: 1.5rem 0;
    padding: 0.25rem 1rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
  .prose :global(.callout) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
  }
  .prose :global(.callout p:first-child) { margin-top: 0; }
  .prose :global(.callout p:last-child) { margin-bottom: 0; }
  .prose :global(.callout::before) {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--color-primary-dark);
  }
  .prose :global(.callout-dica::before) { content: '💡 Dica'; }
  .prose :global(.callout-atencao) {
    border-left-color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }
  .prose :global(.callout-atencao::before) { content: '⚠️ Atenção'; color: var(--color-accent-dark); }
  .prose :global(.callout-importante) {
    border-left-color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 20%, var(--color-surface));
  }
  .prose :global(.callout-importante::before) { content: '❗ Importante'; color: var(--color-accent-dark); }

  /* Card de Produto (sem preço, foco em E-E-A-T) e Card de Estabelecimento
     (pousada/restaurante/hotel). Inseridos como HTML puro pelo editor do CMS
     (blocos "Card de Produto" / "Card de Estabelecimento"), por isso o estilo
     mora aqui e não num componente Astro — veja public/admin/cms/index.html. */
  .prose :global(.card-produto),
  .prose :global(.card-lugar) {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1.75rem 0;
  }
  .prose :global(.card-produto .foto-wrap),
  .prose :global(.card-lugar .foto-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }
  .prose :global(.card-produto .foto-wrap) { padding: 1.25rem; }
  .prose :global(.card-produto .foto-wrap img),
  .prose :global(.card-lugar .foto-wrap img) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .prose :global(.card-produto .foto-wrap img) { object-fit: contain; }
  .prose :global(.card-lugar .foto-wrap img) { object-fit: cover; }
  .prose :global(.card-produto .tipo-badge),
  .prose :global(.card-lugar .tipo-badge) {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    background: rgba(255, 255, 255, 0.94);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .prose :global(.card-produto .conteudo),
  .prose :global(.card-lugar .conteudo) {
    padding: 1.1rem 1.2rem 1.25rem;
  }
  .prose :global(.card-produto h3),
  .prose :global(.card-lugar h3) {
    font-size: 1.1rem;
    margin: 0 0 0.45rem;
  }
  .prose :global(.card-produto .why),
  .prose :global(.card-lugar .descricao) {
    font-size: 0.94rem;
    color: var(--color-text);
    margin: 0 0 0.9rem;
  }
  .prose :global(.card-produto .ctas),
  .prose :global(.card-lugar .links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .prose :global(.card-produto .ctas) { margin-bottom: 0.6rem; }
  .prose :global(.card-produto .btn-loja),
  .prose :global(.card-lugar .btn-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 2px solid transparent;
  }
  /* Cor real de cada marca — reconhecível de cara converte mais do que um
     botão genérico da cor do site. Nome da loja em texto estilizado, não a
     logo oficial (a da Amazon nem existe em bibliotecas de ícone abertas —
     removida por risco de marca — e a do Mercado Livre só existe pro Mercado
     Pago, marca irmã diferente). */
  .prose :global(.card-produto .btn-loja) {
    justify-content: space-between;
    min-width: 200px;
  }
  .prose :global(.card-produto .btn-loja--outro) {
    justify-content: center;
    min-width: 0;
  }
  .prose :global(.card-produto .btn-loja .loja-nome) {
    font-weight: 800;
    font-size: 0.92rem;
  }
  .prose :global(.card-produto .btn-loja--amazon .loja-nome) {
    text-transform: lowercase;
  }
  .prose :global(.card-produto .btn-loja .loja-cta) {
    background: #fff;
    color: var(--color-primary-dark);
    font-weight: 800;
    font-size: 0.76rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }
  .prose :global(.card-produto .btn-loja--outro .loja-cta) {
    background: transparent;
    color: #fff;
    padding: 0;
    border-radius: 0;
  }
  .prose :global(.card-produto .btn-loja--amazon) { background: #ff9900; color: #0f1111; }
  .prose :global(.card-produto .btn-loja--amazon:hover) { background: #e68a00; }
  .prose :global(.card-produto .btn-loja--mercadolivre) { background: #ffe600; color: #2d3277; }
  .prose :global(.card-produto .btn-loja--mercadolivre:hover) { background: #f5d800; }
  .prose :global(.card-produto .btn-loja--booking) { background: #003580; color: #fff; }
  .prose :global(.card-produto .btn-loja--booking:hover) { background: #002a66; }
  .prose :global(.card-produto .btn-loja--rentcar) { background: #00a65a; color: #fff; }
  .prose :global(.card-produto .btn-loja--rentcar:hover) { background: #00893f; }
  .prose :global(.card-produto .btn-loja--outro) { background: var(--color-accent-dark); color: #fff; }
  .prose :global(.card-produto .btn-loja--outro:hover) { background: #7d4f17; }
  /* Mapa e Instagram preenchidos (não contorno) — botão sólido converte mais
     que outline, e a cor de cada um remete ao app real. */
  .prose :global(.card-lugar .btn-link) {
    background: #ea4335;
    color: #fff;
  }
  .prose :global(.card-lugar .btn-link:hover) { background: #d33426; }
  .prose :global(.card-lugar .btn-link.insta) {
    background: linear-gradient(45deg, #feda75, #d62976 60%, #4f5bd5);
    color: #fff;
  }
  .prose :global(.card-lugar .btn-link.insta:hover) { filter: brightness(0.92); }
  .prose :global(.card-produto .disclosure) {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
