---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import Comments from '../components/Comments.astro';
import CardEstabelecimento from '../components/CardEstabelecimento.astro';
import CardProduto from '../components/CardProduto.astro';
import type { ComponentProps } from 'astro/types';
import { SITE, SILOS } from '../consts';
import type { SiloKey } from '../consts';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  silo: SiloKey;
  // Caminho final da página (sem barra no início/fim), ex.: "o-que-fazer" — cada silo tem
  // exatamente um artigo, que vive na raiz do silo, não numa sub-URL própria. Usado no
  // breadcrumb, no schema e como identificador dos comentários (KV do Worker).
  path: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImageWidth: number;
  heroImageHeight: number;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  faq?: { question: string; answer: string }[];
  estabelecimentos?: ComponentProps<typeof CardEstabelecimento>[] | null;
  produtos?: ComponentProps<typeof CardProduto>[] | null;
}

const {
  title,
  seoTitle,
  description,
  silo,
  path,
  heroImage,
  heroImageAlt,
  heroImageWidth,
  heroImageHeight,
  pubDate,
  updatedDate,
  author,
  faq,
  estabelecimentos,
  produtos,
} = Astro.props;

const siloInfo = SILOS[silo];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL(heroImage ?? '/Ilha-grande.webp', SITE.url).toString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: new URL(`/${path}/`, SITE.url).toString(),
};
---

<BaseLayout
  title={seoTitle || title}
  description={description}
  image={heroImage}
  type="article"
  schema={[articleSchema]}
>
  <article class="container article">
    <Breadcrumbs
      items={[
        { label: 'Início', href: '/' },
        { label: title, href: `/${path}/` },
      ]}
    />

    <header class="article-header">
      <p class="badge">{siloInfo.icon} {siloInfo.title}</p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
    </header>

    {heroImage && (
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        width={heroImageWidth}
        height={heroImageHeight}
        loading="eager"
        fetchpriority="high"
        class="hero-image"
      />
    )}

    <AuthorBox author={author} updatedDate={updatedDate ?? pubDate} />

    <div class="prose">
      <slot />
    </div>

    {estabelecimentos && estabelecimentos.length > 0 && (
      <section class="cards-recomendados" aria-label="Estabelecimentos recomendados">
        {estabelecimentos.map((item) => <CardEstabelecimento {...item} />)}
      </section>
    )}

    {produtos && produtos.length > 0 && (
      <section class="cards-recomendados" aria-label="Produtos recomendados">
        {produtos.map((item) => <CardProduto {...item} />)}
      </section>
    )}

    {faq && faq.length > 0 && <FAQ items={faq} />}

    <AdSlot label={`Publicidade em ${siloInfo.title}`} />

    <Comments slug={path} />
  </article>
</BaseLayout>

<style>
  .article { max-width: 780px; padding-block: 2rem 3rem; }
  .article-header { margin-bottom: 1.5rem; }
  .article-lead { color: var(--color-text-muted); font-size: 1.1rem; }
  .hero-image { border-radius: var(--radius); margin-bottom: 1.5rem; }
  .prose :global(h2) { margin-top: 2.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    margin: 1.5rem 0;
    padding: 0.25rem 1rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
  .prose :global(.callout) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
  }
  .prose :global(.callout p:first-child) { margin-top: 0; }
  .prose :global(.callout p:last-child) { margin-bottom: 0; }
  .prose :global(.callout::before) {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--color-primary-dark);
  }
  .prose :global(.callout-dica::before) { content: '💡 Dica'; }
  .prose :global(.callout-atencao) {
    border-left-color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }
  .prose :global(.callout-atencao::before) { content: '⚠️ Atenção'; color: var(--color-accent-dark); }
  .prose :global(.callout-importante) {
    border-left-color: var(--color-accent-dark);
    background: color-mix(in srgb, var(--color-accent) 20%, var(--color-surface));
  }
  .prose :global(.callout-importante::before) { content: '❗ Importante'; color: var(--color-accent-dark); }

  .cards-recomendados { margin-top: 1.5rem; }
</style>
