---
import { SITE } from '../consts';
interface Props {
  author?: string;
  updatedDate?: Date;
}
const { author = SITE.founderName, updatedDate } = Astro.props;
---

<aside class="author-box" aria-label="Sobre o autor">
  <div class="avatar" aria-hidden="true">👤</div>
  <div>
    <p class="author-name">Escrito por {author}</p>
    <p class="author-bio">
      Conteúdo revisado com base em visitas presenciais a Ilha Grande, fontes oficiais
      (ICMBio, Prefeitura de Angra dos Reis) e relatos de moradores locais.
      Veja nossa <a href="/politica-editorial/">política editorial</a>.
    </p>
    {updatedDate && (
      <p class="author-updated">
        Atualizado em {updatedDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
      </p>
    )}
  </div>
</aside>

<style>
  .author-box {
    display: flex;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem;
    margin: 2rem 0;
    align-items: flex-start;
  }
  .avatar {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }
  .author-name { font-weight: 700; margin: 0 0 0.25rem; }
  .author-bio { margin: 0 0 0.35rem; font-size: 0.9rem; color: var(--color-text-muted); }
  .author-updated { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
</style>
