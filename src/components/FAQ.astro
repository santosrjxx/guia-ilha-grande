---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

{items.length > 0 && (
  <section aria-label="Perguntas frequentes">
    <h2>Perguntas frequentes</h2>
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p set:html={item.answer} />
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
