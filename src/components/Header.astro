---
import { SITE, NAV_LINKS } from '../consts';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/logo-header.webp" alt={SITE.name} width="190" height="44" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav" aria-label="Navegação principal">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
  }
  .brand img {
    height: 44px;
    width: auto;
  }
  .nav-toggle { display: none; }
  .nav-toggle-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 0.4rem;
  }
  .nav-toggle-label span {
    width: 24px;
    height: 2px;
    background: var(--color-primary-dark);
    display: block;
  }
  .main-nav {
    display: none;
    width: 100%;
    order: 3;
  }
  .main-nav ul {
    list-style: none;
    margin: 1rem 0 0.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .main-nav a {
    display: block;
    padding: 0.6rem 0.25rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    border-bottom: 1px solid var(--color-border);
  }
  .main-nav a[aria-current='page'] { color: var(--color-primary); }
  .nav-toggle:checked ~ .main-nav { display: block; }

  @media (min-width: 860px) {
    .nav-toggle-label { display: none; }
    .main-nav {
      display: flex !important;
      order: 2;
      width: auto;
      align-items: center;
      gap: 1.5rem;
    }
    .main-nav ul {
      flex-direction: row;
      margin: 0;
      gap: 1.25rem;
    }
    .main-nav a { border-bottom: none; padding: 0.25rem 0; }
  }
</style>
