---
interface Loja {
  provider: 'amazon' | 'mercadoLivre' | 'booking' | 'rentcar' | 'outro';
  label: string;
  url: string;
}
interface Props {
  foto: string;
  fotoAlt?: string | null;
  selo?: string | null;
  nome: string;
  porque: string;
  lojas: Loja[];
}

const { foto, fotoAlt, selo, nome, porque, lojas } = Astro.props;

// Cor de cada loja é a cor real da marca (laranja da Amazon, amarelo do
// Mercado Livre etc.) — botão reconhecível de cara converte mais do que
// um botão genérico da cor do site. O nome da loja aparece em texto
// (não a logo oficial: a da Amazon nem existe em bibliotecas de ícone
// abertas — foi removida por risco de marca — e a do Mercado Livre só
// existe pro Mercado Pago, marca irmã diferente).
const PROVIDER_INFO: Record<string, { cls: string; nome: string }> = {
  amazon: { cls: 'btn-loja--amazon', nome: 'amazon' },
  mercadoLivre: { cls: 'btn-loja--mercadolivre', nome: 'Mercado Livre' },
  booking: { cls: 'btn-loja--booking', nome: 'Booking.com' },
  rentcar: { cls: 'btn-loja--rentcar', nome: 'Rentcars' },
};
---

<div class="card-produto">
  <div class="foto-wrap">
    <img src={foto} alt={fotoAlt || nome} loading="lazy" width="600" height="450" />
    {selo && <span class="tipo-badge">{selo}</span>}
  </div>
  <div class="conteudo">
    <h3>{nome}</h3>
    <p class="why">{porque}</p>
    <div class="ctas">
      {lojas.map((loja) => {
        const info = PROVIDER_INFO[loja.provider];
        const cls = `btn-loja ${info ? info.cls : 'btn-loja--outro'}`;
        return (
          <a class={cls} href={loja.url || '#'} rel="sponsored noopener noreferrer" target="_blank">
            {info && <span class="loja-nome">{info.nome}</span>}
            <span class="loja-cta">{loja.label || 'Ver oferta'} ↗</span>
          </a>
        );
      })}
    </div>
    <p class="disclosure">Link de afiliado — sem custo extra pra você.</p>
  </div>
</div>

<style>
  .card-produto {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1.75rem 0;
  }
  .foto-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    padding: 1.25rem;
  }
  .foto-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  .tipo-badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    background: rgba(255, 255, 255, 0.94);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .conteudo { padding: 1.1rem 1.2rem 1.25rem; }
  h3 { font-size: 1.1rem; margin: 0 0 0.45rem; }
  .why { font-size: 0.94rem; color: var(--color-text); margin: 0 0 0.9rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.6rem; }
  .btn-loja {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 2px solid transparent;
    justify-content: space-between;
    min-width: 200px;
  }
  .btn-loja--outro { justify-content: center; min-width: 0; }
  .loja-nome { font-weight: 800; font-size: 0.92rem; }
  .btn-loja--amazon .loja-nome { text-transform: lowercase; }
  .loja-cta {
    background: #fff;
    color: var(--color-primary-dark);
    font-weight: 800;
    font-size: 0.76rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }
  .btn-loja--outro .loja-cta { background: transparent; color: #fff; padding: 0; border-radius: 0; }
  .btn-loja--amazon { background: #ff9900; color: #0f1111; }
  .btn-loja--amazon:hover { background: #e68a00; }
  .btn-loja--mercadolivre { background: #ffe600; color: #2d3277; }
  .btn-loja--mercadolivre:hover { background: #f5d800; }
  .btn-loja--booking { background: #003580; color: #fff; }
  .btn-loja--booking:hover { background: #002a66; }
  .btn-loja--rentcar { background: #00a65a; color: #fff; }
  .btn-loja--rentcar:hover { background: #00893f; }
  .btn-loja--outro { background: var(--color-accent-dark); color: #fff; }
  .btn-loja--outro:hover { background: #7d4f17; }
  .disclosure { font-size: 0.72rem; color: var(--color-text-muted); margin: 0; }
</style>
