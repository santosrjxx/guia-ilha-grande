---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { SITE } from '../consts';
import anuncie from '../data/anuncie.json';
---

<BaseLayout
  title="Anuncie Conosco"
  description="Anuncie seu restaurante, pousada ou passeio no Guia Ilha Grande e alcance turistas que estão planejando a viagem agora."
>
  <section class="container page">
    <p class="badge">{anuncie.badge}</p>
    <h1>{anuncie.headline}</h1>
    <p class="lead">{anuncie.lead}</p>
    <a href={`mailto:${SITE.email}?subject=Quero anunciar no Guia Ilha Grande`} class="btn btn-primary">
      {anuncie.ctaButtonText}
    </a>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Por que anunciar no {SITE.name}</h2>
      <div class="grid grid-3">
        {anuncie.whyCards.map((card) => (
          <div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
      <p class="disclaimer">
        <em>{anuncie.audienceDisclaimer}</em>
      </p>
    </div>
  </section>

  <section class="section container">
    <h2>Formatos de anúncio</h2>
    <ComparisonTable
      caption="Formatos de publicidade disponíveis"
      headers={["O que é", "Indicado para"]}
      rows={anuncie.adFormats.map((format) => ({
        name: format.name,
        cells: [format.description, format.indicatedFor],
      }))}
    />
    <p class="disclaimer">
      <em>{anuncie.pricingDisclaimer}</em>
    </p>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Como funciona</h2>
      <ol class="steps">
        {anuncie.howItWorksSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <a href="/contato/" class="btn btn-outline">{anuncie.finalCtaText}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page { max-width: 760px; padding-block: 2.5rem 1rem; }
  .lead { font-size: 1.15rem; color: var(--color-text-muted); }
  .disclaimer { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1rem; }
  .steps { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
</style>
