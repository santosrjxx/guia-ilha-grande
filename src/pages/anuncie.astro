---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const entry = await getEntry('pages', 'anuncie');
const { Content } = await render(entry!);
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <article class="container page">
    <h1>Anuncie Conosco</h1>
    <div class="prose">
      <Content />
    </div>

    <div class="contact-grid">
      <!--
        Formulário estático via FormSubmit (sem backend/JS necessário).
        Confirme o endereço no primeiro envio de teste do FormSubmit.
      -->
      <form action={`https://formsubmit.co/${SITE.email}`} method="POST" class="contact-form">
        <input type="hidden" name="_subject" value="Novo pedido de anúncio — Guia Ilha Grande" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <label for="name">Seu nome</label>
        <input id="name" name="name" type="text" required />

        <label for="business">Nome do negócio</label>
        <input id="business" name="business" type="text" required />

        <label for="businessType">Tipo de negócio</label>
        <select id="businessType" name="businessType" required>
          <option value="">Selecione</option>
          <option>Pousada</option>
          <option>Hotel</option>
          <option>Hostel</option>
          <option>Restaurante</option>
          <option>Guia de turismo</option>
          <option>Passeio / Agência</option>
          <option>Transporte (barco, van, táxi)</option>
          <option>Loja / Comércio local</option>
          <option>Outro</option>
        </select>

        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required />

        <label for="phone">WhatsApp / Telefone</label>
        <input id="phone" name="phone" type="tel" />

        <label for="message">Conte um pouco sobre o seu negócio</label>
        <textarea id="message" name="message" rows="5" required></textarea>

        <label class="consent-label" for="consent">
          <input id="consent" type="checkbox" required />
          Li e concordo com a <a href="/politica-de-privacidade/">Política de Privacidade</a> e autorizo o
          tratamento dos meus dados para responder este contato.
        </label>

        <button type="submit" class="btn btn-primary">Quero anunciar meu negócio</button>
      </form>

      <aside class="contact-info">
        <h2>Outros canais</h2>
        <p><strong>E-mail:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>Prefere falar direto? Envie um e-mail com o assunto "Quero anunciar" que respondemos por lá também.</p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .page { max-width: 920px; padding-block: 2rem 3rem; }
  .contact-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
    grid-template-columns: 1fr;
  }
  .contact-form { display: flex; flex-direction: column; gap: 0.35rem; }
  .contact-form label { font-weight: 600; margin-top: 0.5rem; }
  .contact-form input, .contact-form select, .contact-form textarea {
    padding: 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font: inherit;
  }
  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 400;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  .consent-label input { width: auto; margin-top: 0.2rem; }
  .contact-form button { margin-top: 1rem; align-self: flex-start; }
  .contact-info {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.25rem;
    height: fit-content;
  }
  @media (min-width: 780px) {
    .contact-grid { grid-template-columns: 2fr 1fr; }
  }
</style>
