---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SILOS } from '../../consts';
import { getCollection } from 'astro:content';

const silo = SILOS['o-que-fazer'];
const articles = (await getCollection('articles', (a) => a.data.silo === 'o-que-fazer' && !a.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${silo.title} em Ilha Grande`} description={silo.shortDescription}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: silo.title, href: '/o-que-fazer/' }]} />
    <header class="silo-header">
      <p class="badge">{silo.icon} Silo: {silo.title}</p>
      <h1>O Que Fazer em Ilha Grande</h1>
      <p class="silo-lead">{silo.shortDescription}</p>
    </header>

    <div class="grid grid-3">
      {articles.map((article) => (
        <a href={`/o-que-fazer/${article.data.slug ?? article.id}/`} class="card">
          {article.data.heroImage && (
            <img src={article.data.heroImage} alt={article.data.heroImageAlt ?? article.data.title} class="card-image" loading="lazy" width="1200" height="675" />
          )}
          <div class="card-body">
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
          </div>
        </a>
      ))}
    </div>

    <AdSlot label="Publicidade em O Que Fazer" />
  </div>
</BaseLayout>

<style>
  .silo-header { max-width: 680px; margin-bottom: 2rem; }
  .silo-lead { color: var(--color-text-muted); font-size: 1.1rem; }
</style>
