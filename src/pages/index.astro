---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, SILOS, AD_CONTACT_URL } from '../consts';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);
const byDate = [...allArticles].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const byId = (id: string) => allArticles.find((a) => a.id === id)!;

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const featuredArticle = allArticles.find((a) => a.data.featured) ?? byDate[0];
const popularArticles = allArticles.filter((a) => a.data.popular).slice(0, 4);
const recentTabArticles = byDate.slice(0, 4);

const editorsPickMain = byId('onde-ficar-em-ilha-grande');
const editorsPickList = ['praia-de-lopes-mendes', 'como-chegar-a-ilha-grande', 'restaurantes-pos-trilha'].map(byId);

const trendingGrid = [
  'trilha-pico-do-papagaio',
  'onde-comer-vila-do-abraao',
  'vila-do-abraao-vs-outras-praias',
  'o-que-levar-na-mala',
].map(byId);

const inspirationDuo = ['praia-de-lopes-mendes', 'trilha-pico-do-papagaio'].map(byId);

const topics = Object.values(SILOS).map((silo) => ({
  ...silo,
  count: allArticles.filter((a) => a.data.silo === silo.slug).length,
}));

const tagCloud = [...new Set(allArticles.flatMap((a) => a.data.tags))];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
};
---

<BaseLayout title={SITE.name} description={SITE.description} schema={[websiteSchema]}>
  <!-- HERO: destaque + abas Populares/Recentes -->
  <section class="section hero-section">
    <div class="container hero-grid">
      <a href={`/${featuredArticle.data.silo}/${featuredArticle.data.slug ?? featuredArticle.id}/`} class="hero-feature">
        <img
          src={featuredArticle.data.heroImage}
          alt={featuredArticle.data.heroImageAlt ?? featuredArticle.data.title}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-feature-overlay">
          <p class="badge badge-accent">{SILOS[featuredArticle.data.silo].title}</p>
          <h1>{featuredArticle.data.title}</h1>
          <p class="hero-feature-meta">{featuredArticle.data.author} · {fmt(featuredArticle.data.pubDate)}</p>
        </div>
      </a>

      <aside class="tabs-widget">
        <input type="radio" name="hero-tabs" id="tab-popular" class="tab-input" checked />
        <input type="radio" name="hero-tabs" id="tab-recent" class="tab-input" />
        <div class="tab-headers">
          <label for="tab-popular" class="tab-label">Populares</label>
          <label for="tab-recent" class="tab-label">Recentes</label>
        </div>

        <ol class="tab-panel panel-popular">
          {popularArticles.map((article, i) => (
            <li>
              <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="mini-post">
                <span class="mini-post-number">{i + 1}</span>
                <img src={article.data.heroImage} alt="" width="70" height="70" loading="lazy" />
                <span>
                  <strong>{article.data.title}</strong>
                  <time>{fmt(article.data.pubDate)}</time>
                </span>
              </a>
            </li>
          ))}
        </ol>

        <ol class="tab-panel panel-recent">
          {recentTabArticles.map((article, i) => (
            <li>
              <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="mini-post">
                <span class="mini-post-number">{i + 1}</span>
                <img src={article.data.heroImage} alt="" width="70" height="70" loading="lazy" />
                <span>
                  <strong>{article.data.title}</strong>
                  <time>{fmt(article.data.pubDate)}</time>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <!-- ESCOLHA DA EQUIPE -->
  <section class="section section-alt">
    <div class="container">
      <h2>Escolha da Equipe <span class="title-deco" aria-hidden="true">〰️</span></h2>
      <div class="editors-grid">
        <a href={`/${editorsPickMain.data.silo}/${editorsPickMain.data.slug ?? editorsPickMain.id}/`} class="editors-main">
          <img src={editorsPickMain.data.heroImage} alt={editorsPickMain.data.heroImageAlt ?? editorsPickMain.data.title} width="1200" height="675" loading="lazy" />
          <div class="editors-main-body">
            <p class="badge">{SILOS[editorsPickMain.data.silo].title}</p>
            <h3>{editorsPickMain.data.title}</h3>
            <p>{editorsPickMain.data.description}</p>
          </div>
        </a>
        <ul class="editors-list">
          {editorsPickList.map((article) => (
            <li>
              <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="compact-post">
                <img src={article.data.heroImage} alt="" width="110" height="80" loading="lazy" />
                <span>
                  <strong>{article.data.title}</strong>
                  <time>{fmt(article.data.pubDate)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- MAIS PROCURADOS -->
  <section class="section">
    <div class="container">
      <h2>Mais Procurados <span class="title-deco" aria-hidden="true">〰️</span></h2>
      <div class="grid grid-4">
        {trendingGrid.map((article) => (
          <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="card">
            <img src={article.data.heroImage} alt={article.data.heroImageAlt ?? article.data.title} class="card-image" loading="lazy" width="1200" height="675" />
            <div class="card-body">
              <p class="badge">{SILOS[article.data.silo].title}</p>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INSPIRE-SE -->
  <section class="section section-alt">
    <div class="container">
      <h2>Inspire-se <span class="title-deco" aria-hidden="true">〰️</span></h2>
      <div class="inspiration-grid">
        {inspirationDuo.map((article) => (
          <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="inspiration-card">
            <img src={article.data.heroImage} alt={article.data.heroImageAlt ?? article.data.title} width="900" height="600" loading="lazy" />
            <div class="inspiration-overlay">
              <p class="badge badge-accent">{SILOS[article.data.silo].title}</p>
              <h3>{article.data.title}</h3>
              <p class="inspiration-meta">{article.data.author} · {fmt(article.data.pubDate)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot label="Publicidade na página inicial" />
  </div>

  <!-- POSTS RECENTES + SIDEBAR -->
  <section class="section">
    <div class="container recent-layout">
      <div class="recent-main">
        <h2>Todos os Posts <span class="title-deco" aria-hidden="true">〰️</span></h2>
        <ul class="recent-list">
          {byDate.map((article) => (
            <li>
              <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="recent-item">
                <img src={article.data.heroImage} alt={article.data.heroImageAlt ?? article.data.title} width="320" height="200" loading="lazy" />
                <div class="recent-item-body">
                  <p class="recent-item-meta">{SILOS[article.data.silo].title} · {fmt(article.data.pubDate)}</p>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="sidebar">
        <div class="widget">
          <h3>{SITE.name}</h3>
          <p>{SITE.description}</p>
          <a href="/sobre/" class="btn btn-outline widget-btn">Conheça o guia</a>
        </div>

        <div class="widget">
          <h3>Posts Populares</h3>
          <ol class="widget-list">
            {popularArticles.map((article, i) => (
              <li>
                <a href={`/${article.data.silo}/${article.data.slug ?? article.id}/`} class="mini-post">
                  <span class="mini-post-number">{i + 1}</span>
                  <img src={article.data.heroImage} alt="" width="60" height="60" loading="lazy" />
                  <span>
                    <strong>{article.data.title}</strong>
                    <time>{fmt(article.data.pubDate)}</time>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div class="widget">
          <h3>Explorar Tópicos</h3>
          <ul class="widget-list topics-list">
            {topics.map((topic) => (
              <li>
                <a href={`/${topic.slug}/`}>
                  <span>{topic.icon} {topic.title}</span>
                  <span class="topic-count">{topic.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="widget widget-newsletter">
          <h3>Receba Novidades</h3>
          <p>Dicas novas sobre Ilha Grande direto no seu e-mail, sem spam.</p>
          <form action="https://formsubmit.co/guiadeilhagrande@gmail.com" method="POST" class="newsletter-form">
            <input type="hidden" name="_subject" value="Nova inscrição na newsletter — Guia Ilha Grande" />
            <input type="email" name="email" placeholder="Seu e-mail" required aria-label="Seu e-mail" />
            <button type="submit" class="btn btn-primary">Inscrever-se</button>
          </form>
        </div>

        <div class="widget">
          <h3>Destaque</h3>
          <a href={`/${featuredArticle.data.silo}/${featuredArticle.data.slug ?? featuredArticle.id}/`} class="compact-post">
            <img src={featuredArticle.data.heroImage} alt="" width="110" height="80" loading="lazy" />
            <span>
              <strong>{featuredArticle.data.title}</strong>
              <time>{fmt(featuredArticle.data.pubDate)}</time>
            </span>
          </a>
        </div>

        <div class="widget">
          <h3>Nuvem de Tags</h3>
          <div class="tag-cloud">
            {tagCloud.map((tag) => <span class="tag-pill">#{tag}</span>)}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section container cta-owner">
    <div class="cta-owner-box">
      <div>
        <h2>Tem um negócio em Ilha Grande?</h2>
        <p>Restaurantes, pousadas e guias de turismo podem anunciar diretamente para quem está planejando a viagem agora.</p>
      </div>
      <a href={AD_CONTACT_URL} class="btn btn-primary">Quero anunciar</a>
    </div>
  </section>
</BaseLayout>

<style>
  .title-deco { font-size: 0.9rem; opacity: 0.6; }

  /* HERO */
  .hero-section { padding-top: 2rem; }
  .hero-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  .hero-feature {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    min-height: 320px;
  }
  .hero-feature img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-feature-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.5rem;
    background: linear-gradient(180deg, rgba(7, 53, 49, 0) 30%, rgba(7, 53, 49, 0.92) 100%);
  }
  .hero-feature-overlay h1 { color: #fff; margin: 0; font-size: clamp(1.5rem, 3.5vw, 2.25rem); }
  .hero-feature-meta { margin: 0; font-size: 0.9rem; opacity: 0.9; }
  .badge-accent { background: var(--color-accent-dark); color: #fff; width: fit-content; }

  /* Tabs widget */
  .tabs-widget {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.25rem;
    border: 1px solid var(--color-border);
  }
  .tab-input { position: absolute; opacity: 0; pointer-events: none; }
  .tab-headers { display: flex; gap: 1.25rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1rem; }
  .tab-label {
    cursor: pointer;
    font-weight: 700;
    padding-bottom: 0.6rem;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
  }
  .tab-panel { display: none; list-style: none; margin: 0; padding: 0; }
  #tab-popular:checked ~ .tab-headers .tab-label[for='tab-popular'],
  #tab-recent:checked ~ .tab-headers .tab-label[for='tab-recent'] {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-accent-dark);
  }
  #tab-popular:checked ~ .panel-popular { display: flex; flex-direction: column; gap: 0.9rem; }
  #tab-recent:checked ~ .panel-recent { display: flex; flex-direction: column; gap: 0.9rem; }

  .mini-post { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: inherit; }
  .mini-post-number {
    flex-shrink: 0;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--color-accent-dark);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .mini-post img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .mini-post strong { display: block; font-size: 0.9rem; line-height: 1.3; }
  .mini-post time { font-size: 0.78rem; color: var(--color-text-muted); }

  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: 2fr 1fr; align-items: stretch; }
  }

  /* Editors picks */
  .editors-grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  .editors-main { display: block; text-decoration: none; color: inherit; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--color-border); background: #fff; }
  .editors-main img { width: 100%; height: 260px; object-fit: cover; display: block; }
  .editors-main-body { padding: 1.25rem; }
  .editors-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }

  .compact-post { display: flex; gap: 0.85rem; text-decoration: none; color: inherit; align-items: center; }
  .compact-post img { width: 96px; height: 70px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .compact-post strong { display: block; font-size: 0.95rem; line-height: 1.35; }
  .compact-post time { font-size: 0.78rem; color: var(--color-text-muted); }

  @media (min-width: 900px) {
    .editors-grid { grid-template-columns: 2fr 1fr; }
  }

  /* Inspiration */
  .inspiration-grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  .inspiration-card { position: relative; display: block; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; min-height: 260px; }
  .inspiration-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .inspiration-overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 0.4rem;
    padding: 1.25rem;
    background: linear-gradient(180deg, rgba(7,53,49,0) 40%, rgba(7,53,49,0.9) 100%);
  }
  .inspiration-overlay h3 { color: #fff; margin: 0; }
  .inspiration-meta { margin: 0; font-size: 0.85rem; opacity: 0.9; }
  @media (min-width: 760px) {
    .inspiration-grid { grid-template-columns: 1fr 1fr; }
  }

  /* Recent + sidebar */
  .recent-layout { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  .recent-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .recent-item { display: flex; gap: 1.25rem; text-decoration: none; color: inherit; }
  .recent-item img { width: 200px; height: 130px; object-fit: cover; border-radius: var(--radius); flex-shrink: 0; }
  .recent-item-meta { font-size: 0.8rem; color: var(--color-text-muted); margin: 0 0 0.25rem; }
  .recent-item-body h3 { margin: 0 0 0.35rem; }
  .recent-item-body p { margin: 0; color: var(--color-text-muted); }

  .sidebar { display: flex; flex-direction: column; gap: 1.75rem; }
  .widget {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .widget h3 { margin-top: 0; }
  .widget-btn { margin-top: 0.5rem; }
  .widget-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .topics-list a {
    display: flex; align-items: center; justify-content: space-between;
    text-decoration: none; color: var(--color-text); font-weight: 600;
    padding: 0.4rem 0; border-bottom: 1px solid var(--color-border);
  }
  .topic-count {
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
  }
  .widget-newsletter { background: var(--color-primary-dark); border-color: var(--color-primary-dark); color: #fff; }
  .widget-newsletter h3, .widget-newsletter p { color: #fff; }
  .newsletter-form { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.75rem; }
  .newsletter-form input {
    padding: 0.65rem; border-radius: 8px; border: none; font: inherit;
  }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-pill {
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
  }

  @media (min-width: 960px) {
    .recent-layout { grid-template-columns: 2fr 1fr; }
  }

  /* CTA final */
  .cta-owner-box {
    background: var(--color-primary-dark);
    color: #fff;
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .cta-owner-box h2, .cta-owner-box p { color: #fff; margin: 0; }
  @media (min-width: 760px) {
    .cta-owner-box { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
